# ==============================================================================
# Bleep Education 40 Industry AI Projects - Environment Template
# Copy this file to .env in your root or project directory:
#   cp .env.example .env
# ==============================================================================

# --- Execution Environment & Global Configuration ---
ENVIRONMENT=development
RANDOM_SEED=42
LOG_LEVEL=INFO

# --- Local LLM & Ollama Configuration (Default Offline / Local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_REQUEST_TIMEOUT=60

# --- Cloud LLM Fallbacks (Optional - Required only if Ollama is unavailable) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# --- Vector Store & Embeddings Configuration (Part C: RAG) ---
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.65

# --- Agentic AI Configuration & Safety Guardrails (Part D: AG) ---
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=60
REQUIRE_HITL_CONFIRMATION=true
STRICT_SAFETY_MODE=true
AGENT_EXECUTION_TRACE_PATH=./results/agent_trace.json

# --- Interactive Streamlit Web App Configuration ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=true

# --- Automated PDF Project Report Metadata ---
REPORT_AUTHOR=Bleep AI Engineering Team
REPORT_ORGANIZATION=Bleep Education
